# BalanceVault Environment Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Neon / PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public&sslmode=require
DATABASE_URL="postgresql://bv_app_user:bv_secure_password@localhost:5432/balancevault?schema=public"

# Distributed Rate Limiting (Redis)
REDIS_URL="redis://localhost:6379"

# Cryptographic Token Security
JWT_SECRET="balancevault-super-secure-production-jwt-secret-key-2026"
JWT_EXPIRES_IN="24h"

# First Administrator Initial Configuration
ADMIN_EMAIL="admin@balancevault.internal"
ADMIN_PASSWORD="AdminVault2026!Secure"
ADMIN_NAME="Primary System Administrator"
PG_OPERATOR_ROLE="bootstrap_operator"

